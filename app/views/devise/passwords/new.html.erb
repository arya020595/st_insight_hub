<div id="login-page">
  <div class="login-wrapper">
    <div class="login-container">
      <div class="brand-section">
        <%= image_tag "st_insight_hub_logo.png", alt: "ST Insight Hub", class: "brand-logo" %>
        <p class="brand-subtitle">Forgot your password?</p>
      </div>
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div class="field">
          <%= f.label :email %><br />
          <%= f.email_field :email, autofocus: true, placeholder: "Enter your email address", autocomplete: "email", class: "custom-input" %>
        </div>
        <%= render "layouts/flash" %>
        <div class="actions">
          <%= f.submit "Send reset instructions" %>
        </div>
      <% end %>
      <div class="auth-links">
        <%= link_to "Back to login", new_session_path(resource_name) %>
      </div>
      <div class="powered-by text-center">
        <p class="powered-by-text">Powered by</p>
        <div class="powered-by-partners">
          <span class="partner-name">ST Advisory</span>
          <span class="separator">|</span>
          <span class="partner-name">ST Datablu</span>
        </div>
      </div>
    </div>
    <div class="login-background"></div>
  </div>
</div>
