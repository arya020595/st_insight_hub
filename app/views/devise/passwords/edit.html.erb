<div id="login-page">
  <div class="login-wrapper">
    <div class="login-container">
      <div class="brand-section">
        <%= image_tag "st_insight_hub_logo.png", alt: "ST Insight Hub", class: "brand-logo" %>
        <p class="brand-subtitle">Change your password</p>
      </div>
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>
        <div class="field">
          <%= f.label :password, "New password" %><br />
          <%= f.password_field :password, autofocus: true, placeholder: "Enter new password", autocomplete: "new-password", class: "custom-input" %>
          <% if @minimum_password_length %>
            <em class="password-hint"><%= @minimum_password_length %> characters minimum</em>
          <% end %>
        </div>
        <div class="field">
          <%= f.label :password_confirmation, "Confirm new password" %><br />
          <%= f.password_field :password_confirmation, placeholder: "Confirm new password", autocomplete: "new-password", class: "custom-input" %>
        </div>
        <%= render "layouts/flash" %>
        <div class="actions">
          <%= f.submit "CHANGE PASSWORD" %>
        </div>
      <% end %>
      <div class="auth-links">
        <%= link_to "Back to login", new_session_path(resource_name) %>
      </div>
      <div class="powered-by text-center">
        <p class="powered-by-text">Powered by</p>
        <div class="powered-by-partners">
          <span class="partner-name">ST Advisory</span>
          <span class="separator">|</span>
          <span class="partner-name">ST Datablu</span>
        </div>
      </div>
    </div>
    <div class="login-background"></div>
  </div>
</div>
